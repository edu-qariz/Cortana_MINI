# ═══════════════════════════════════════════════
# CORTANA MINI V2.3 - environment
# Copy to .env and fill what you need. Never commit .env.
#
# Where this file belongs: %LOCALAPPDATA%\CortanaMini\.env on Windows
# (or $CORTANA_HOME/.env). A .env in the app folder still works but is
# deprecated: it is moved to the state folder on the next start, because
# an update replaces the app folder.
# ═══════════════════════════════════════════════

# Bot identity
BOT_NAME=CORTANA PRO MINI
PREFIX=.

# Owner numbers, international format without +, comma separated
OWNER_NUMBERS=

# Fixed 8-character pairing code. Type it with no hyphen and no spaces.
PAIRING_CODE=CORTANA2

# Set to off to skip the console pairing prompt (panel-only pairing)
PAIR_PROMPT=on

# In-chat HTML game wrapper: forwarded | clean | bare
HTML_UI_VARIANT=forwarded

# Web panel
PORT=8099
# Optional shared secret for panel actions. Strongly recommended on a public host.
PANEL_TOKEN=

# Licence server (Cloudflare Worker) and this install's licence key.
# Without CORTANA_API the bot runs ungated in local mode, which is only meant for development.
CORTANA_API=
LICENCE_KEY=
CHANNEL=stable
API_TIMEOUT_MS=15000

# Optional menu image URL used until .setimage is used
MENU_IMAGE=

# AI providers (any one is enough)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: GNews key for worldwide/tech headlines with images.
# Without it, the bot falls back to BBC World and Engadget RSS (no key needed).
GNEWS_API_KEY=

# Optional KnightBot key for media downloads. The default public key ("knight")
# is rate-limited; set your own key if downloads start failing.
KNIGHTBOT_API_KEY=knight

# Limits and maintenance
RATE_LIMIT_PER_10S=8
MAX_MEDIA_MB=48
AI_MEMORY_TURNS=8
LOG_LEVEL=info
