# Cortana Mini — client settings
# Lives in %LOCALAPPDATA%\CortanaMini\.env (Windows) or ~/.cortana-mini/.env (Linux).
# Never inside the app folder: updates replace that folder.

BOT_NAME=CORTANA PRO MINI
PREFIX=.
PAIRING_CODE=CORTANA2

PORT=8099
PANEL_TOKEN=

# Provided with your copy.
CORTANA_API=
LICENCE_KEY=

# Pick up new client builds on restart. Command changes never need this.
AUTO_UPDATE=on
