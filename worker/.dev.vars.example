# Copy to .dev.vars for `wrangler dev`, then set the same names with
#   npx wrangler secret put LICENCE_SECRET
# before deploying. .dev.vars is git-ignored.

# 32+ random bytes. Generate with: node tools/keygen.js secret
LICENCE_SECRET=

# Pooled provider keys used by /v1/plan for the ai commands.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional content keys for news commands.
GNEWS_API_KEY=
